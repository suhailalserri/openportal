{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "GATEWAY_URL",
    "GATEWAY_MASTER_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "INTERNAL_SERVICE_TOKEN",
    "INTERNAL_API_URL",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "RESEND_FROM_NAME",
    "CODE_SALT",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHAT_ID",
    "TURNSTILE_SECRET_KEY",
    "MINIO_ENDPOINT",
    "MINIO_ACCESS_KEY",
    "MINIO_SECRET_KEY",
    "FRONTEND_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@ai-platform/api#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint":       { "dependsOn": ["^lint"] },
    "type-check": { "dependsOn": ["^type-check"] },
    "test":       { "cache": false, "dependsOn": [] },
    "db:generate":{ "cache": false },
    "db:migrate": { "cache": false }
  }
}
