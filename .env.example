# ══════════════════════════════════════════════════════════════════════
# openportal — environment variables
#
# Production topology (ADR-011): web = Vercel, api = Render,
# Postgres = Supabase, Redis = Upstash, gateway (New API) = Render.
# There is NO local docker-compose stack any more. Locally, point these
# at your own Postgres/Redis or at throwaway cloud instances.
#
# NEVER commit real values. Set them in the Vercel and Render dashboards.
# ══════════════════════════════════════════════════════════════════════

# ── REQUIRED BY BOTH web (Vercel) AND api (Render) ──────────────────
# apps/api/src/config.ts is imported by both (web hosts the same tRPC
# router in-process), and it throws at import time if any of these is
# missing or malformed. Set them on BOTH services.

# Supabase → Project → Connect. Use the TRANSACTION-mode pooler string
# (port 6543) for Vercel: session mode caps clients low and every
# serverless invocation opens its own connection.
DATABASE_URL=postgres://postgres.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres
# 1 for serverless (Vercel). For the long-lived Render api, raise it
# deliberately (see ADR-011 and plan P4.2); the default is 1.
DATABASE_POOL_MAX=1
# Set to "disable" only for a local Postgres without TLS.
# DATABASE_SSL=disable

# Upstash → database → Details. Must be the TLS (rediss://) TCP URL,
# not the REST URL: BullMQ and ioredis need the Redis protocol.
REDIS_URL=rediss://default:CHANGE_ME@YOUR-DB.upstash.io:6379

# New API gateway (its own Render service). GATEWAY_URL is the URL the
# api can reach it on. Keep it reachable only from the api if you can.
GATEWAY_URL=https://your-gateway.onrender.com
# OpenAI-compatible chat key (used for /v1/*)
GATEWAY_MASTER_KEY=CHANGE_ME_GATEWAY_MASTER_KEY
# New API admin/system access token (used for /api/*). NOT the same
# credential as GATEWAY_MASTER_KEY. Keep secret.
GATEWAY_ROOT_TOKEN=CHANGE_ME_GATEWAY_ADMIN_TOKEN

# Generate each with: openssl rand -hex 32   (all need 32+ chars)
BETTER_AUTH_SECRET=CHANGE_ME_AUTH_SECRET_32_CHARS_MIN
# Shared secret between web and api for internal calls. Must be
# identical on both.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_TOKEN_32_CHARS_MIN
# P1.3 client-IP trust (apps/api). Both optional.
# Number of trusted proxy hops in front of the api (Render edge = 1). 0 turns trustProxy off.
TRUSTED_PROXY_HOPS=1
# Trust cf-connecting-ip on direct api calls (Render's edge is Cloudflare). Set to false to ignore it.
TRUST_CF_CONNECTING_IP=true
# Salt for redeem-code checksums. Changing it invalidates issued codes.
CODE_SALT=CHANGE_ME_RANDOM_SALT_FOR_CHECKSUM_64CHARS

BETTER_AUTH_URL=https://chat.yourdomain.com
FRONTEND_URL=https://chat.yourdomain.com

# Resend — verify the sending domain first (SPF/DKIM/DMARC).
RESEND_API_KEY=re_CHANGE_ME_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=OpenPortal

# ── web (Vercel) ONLY ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://chat.yourdomain.com
NEXT_PUBLIC_APP_NAME=OpenPortal
NEXT_PUBLIC_APP_NAME_AR=البوابة المفتوحة
# The api's PUBLIC base URL (Vercel cannot reach Render's private network).
INTERNAL_API_URL=https://your-api.onrender.com
# Set to "true" on Production to 404 the /dev/* pages. Leave unset on Preview.
# HIDE_KITCHEN_SINK=true

# Cloudflare Turnstile. Leave the secret empty to no-op the server check.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY

# ── api (Render) ONLY ───────────────────────────────────────────────
PORT=4000
# Telegram alerts (BotFather → /newbot; @userinfobot for the chat id).
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=CHANGE_ME_YOUR_TELEGRAM_CHAT_ID
# P2.2: secret in the URL of POST /internal/sentry-alert (Sentry -> Telegram). 24+ chars; empty = endpoint disabled.
SENTRY_WEBHOOK_TOKEN=
# Cheap model used for internal history summarisation (never billed).
# SUMMARIZATION_MODEL=gpt-4o-mini

# ── ERROR MONITORING (Sentry, web) — optional ───────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN empty to switch monitoring fully off.
# NEXT_PUBLIC_* values are inlined at BUILD time: set them in Vercel
# (Preview + Production) BEFORE the deploy that should use them.
# Use "preview" on Vercel Preview and "production" on Production.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Build-time only, source-map upload (NEVER prefix with NEXT_PUBLIC_).
# Leave SENTRY_AUTH_TOKEN empty to skip upload (readable stacks need it).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── ERROR MONITORING (Sentry, api) — Render only, optional (plan P2.1) ──
# Server-side, so NOT prefixed NEXT_PUBLIC_. Blank or invalid => monitoring is
# OFF and the api boots normally (a bad value never stops it).
# Use a SEPARATE Sentry project from web, or the same one: every api event is
# tagged service:api, and release = the deployed commit (RENDER_GIT_COMMIT,
# set by Render automatically; override with SENTRY_RELEASE only if needed).
# Drill: POST {api}/internal/sentry-test with
#   Authorization: Bearer $INTERNAL_SERVICE_TOKEN
# => 500, and one "Sentry smoke test ... (deliberate)" issue within a minute.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=

# ── GOOGLE SIGN-IN (optional) ───────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# NEXT_PUBLIC_GOOGLE_SIGNIN is inlined at BUILD time: redeploy after changing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# ── PASSKEYS (optional) ─────────────────────────────────────────────
# Apply packages/db/src/migrations/0011_passkey.sql to the database FIRST.
# A passkey is bound to the domain it was created on (the "RP ID"): enable
# this only on the production domain you intend to keep. PASSKEY_RP_ID
# defaults to the hostname of BETTER_AUTH_URL.
# NEXT_PUBLIC_PASSKEY_ENABLED is inlined at BUILD time: redeploy after changing.
PASSKEY_RP_ID=
NEXT_PUBLIC_PASSKEY_ENABLED=false

# ── PAYMENTS ────────────────────────────────────────────────────────
# Active methods are Jaib vouchers and manual transfer (ADR-007), managed
# in the admin panel: no keys needed. Moyasar is disabled, not removed.
# MOYASAR_WEBHOOK_SECRET=CHANGE_ME

# ── AI PROVIDER KEYS ────────────────────────────────────────────────
# Do NOT put these here. They live only in the New API admin panel
# (your gateway service), never in this app's environment.

# ── GRACEFUL SHUTDOWN (P3.2, optional) ──────────────────────────────
# On SIGTERM the API drains in-flight /chat streams for SHUTDOWN_DRAIN_MS, then
# aborts the rest (they bill what was streamed), then waits SHUTDOWN_ABORT_GRACE_MS.
# Render's "Shutdown delay" must be > drain + grace + 12 s (120 s with the defaults).
# See docs/runbooks/DEPLOY_SHUTDOWN.md.
# SHUTDOWN_DRAIN_MS=90000
# SHUTDOWN_ABORT_GRACE_MS=15000

