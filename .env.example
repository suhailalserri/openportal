# ══════════════════════════════════════════════════════════════════════
# AI Platform Environment Variables
# Copy this file to .env and fill in all values before starting.
# NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════

# ── DOMAIN ──────────────────────────────────────────────────────────
DOMAIN=yourdomain.com

# Your IP address (for Grafana access restriction in Caddy)
ADMIN_IP=1.2.3.4

# ── BRANDING ────────────────────────────────────────────────────────
APP_NAME=OpenPortal 
APP_NAME_AR=البوابة المفتوحة

# ── DATABASE ────────────────────────────────────────────────────────
POSTGRES_DB=aiplatform
POSTGRES_USER=aiplatform_user
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# Full DSN (used by apps)
DATABASE_URL=postgres://aiplatform_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/aiplatform

# ── REDIS ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1

# ── AI GATEWAY (New API) ────────────────────────────────────────────
GATEWAY_URL=http://gateway:3000
# Generate with: openssl rand -hex 32
GATEWAY_SESSION_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
# This is the admin API token for New API — keep secret
GATEWAY_ROOT_TOKEN=CHANGE_ME_GATEWAY_ADMIN_TOKEN
GATEWAY_MASTER_KEY=CHANGE_ME_GATEWAY_MASTER_KEY

# ── AUTHENTICATION (Better Auth) ────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_AUTH_SECRET_32_CHARS_MIN
# Shared secret between web (Next.js) and api (Fastify) for internal service calls.
# Must be identical in both apps. Generate with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_TOKEN_32_CHARS_MIN
AUTH_SECRET=CHANGE_ME_AUTH_SECRET_32_CHARS_MIN
BETTER_AUTH_URL=https://chat.yourdomain.com

# ── NEXT.JS PUBLIC VARS ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://chat.yourdomain.com
NEXT_PUBLIC_APP_NAME=AI Platform
NEXT_PUBLIC_APP_NAME_AR=منصة الذكاء الاصطناعي
FRONTEND_URL=https://chat.yourdomain.com

# ── EMAIL (Resend) ──────────────────────────────────────────────────
# Get from: resend.com — free tier = 3000 emails/month
RESEND_API_KEY=re_CHANGE_ME_YOUR_RESEND_KEY
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=AI Platform

# ── OBJECT STORAGE (MinIO) ──────────────────────────────────────────
# Generate with: openssl rand -hex 16
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY_32CHARS
MINIO_ENDPOINT=minio:9000

# ── MONITORING ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 16
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# ── ALERTS (Telegram) ───────────────────────────────────────────────
# 1. Create a bot: message @BotFather on Telegram → /newbot
# 2. Get chat ID: message @userinfobot
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN_FROM_BOTFATHER
TELEGRAM_CHAT_ID=CHANGE_ME_YOUR_TELEGRAM_CHAT_ID

# ── SECURITY ────────────────────────────────────────────────────────
# Salt for redeem code checksum — generate with: openssl rand -hex 32
CODE_SALT=CHANGE_ME_RANDOM_SALT_FOR_CHECKSUM_64CHARS

# Cloudflare Turnstile (free CAPTCHA) — get at: dash.cloudflare.com
NEXT_PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY

# ── ERROR MONITORING (Sentry) — optional ────────────────────────────
# Leave NEXT_PUBLIC_SENTRY_DSN empty to switch monitoring fully off.
# NEXT_PUBLIC_* values are inlined at BUILD time: set them in Vercel
# (Preview + Production) BEFORE the deploy that should use them.
# Use "preview" on Vercel Preview and "production" on Production.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Build-time only, source-map upload (NEVER prefix with NEXT_PUBLIC_).
# Leave SENTRY_AUTH_TOKEN empty to skip upload (readable stacks need it).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── PAYMENTS (Add when ready — Phase 2) ────────────────────────────
# Moyasar (Saudi Arabia) — moyasar.com
# MOYASAR_SECRET_KEY=sk_live_CHANGE_ME
# MOYASAR_PUBLISHABLE_KEY=pk_live_CHANGE_ME
# MOYASAR_WEBHOOK_SECRET=CHANGE_ME

# ── AI PROVIDER API KEYS ─────────────────────────────────────────────
# NOTE: Add these via the New API admin panel (http://localhost:3001)
# Keep backup copies here for reference only — never expose in code
# OPENAI_API_KEY_PRIMARY=sk-CHANGE_ME
# OPENAI_API_KEY_BACKUP=sk-CHANGE_ME
# ANTHROPIC_API_KEY_PRIMARY=sk-ant-CHANGE_ME
# ANTHROPIC_API_KEY_BACKUP=sk-ant-CHANGE_ME
# GOOGLE_AI_API_KEY=AIza-CHANGE_ME
# DEEPSEEK_API_KEY=sk-CHANGE_ME

# ── GOOGLE SIGN-IN (optional) ────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# NEXT_PUBLIC_GOOGLE_SIGNIN is inlined at BUILD time: redeploy after changing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_SIGNIN=false

# ── PASSKEYS (optional) ──────────────────────────────────────────────
# Apply packages/db/src/migrations/0011_passkey.sql to the database FIRST.
# A passkey is bound to the domain it was created on (the "RP ID"): enable
# this only on the production domain you intend to keep. PASSKEY_RP_ID
# defaults to the hostname of BETTER_AUTH_URL.
# NEXT_PUBLIC_PASSKEY_ENABLED is inlined at BUILD time: redeploy after changing.
PASSKEY_RP_ID=
NEXT_PUBLIC_PASSKEY_ENABLED=false
