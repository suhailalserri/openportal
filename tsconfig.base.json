{
  "compilerOptions": {
    "target":            "ES2022",
    "lib":               ["ES2022"],
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "strict":            true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess":   true,
    "noImplicitOverride":         true,
    "verbatimModuleSyntax":       false,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "resolveJsonModule": true,
    "sourceMap":         true
  }
}
