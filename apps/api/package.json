{
  "name": "@ai-platform/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routers": "./src/routers/index.ts",
    "./services/redeem": "./src/services/redeem.service.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "type-check": "tsc --noEmit",
    "db:migrate": "cd ../../packages/db && pnpm db:migrate",
    "db:seed": "cd ../../packages/db && pnpm tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-platform/config": "workspace:*",
    "@ai-platform/db": "workspace:*",
    "@ai-platform/types": "workspace:*",
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.0",
    "resend": "^3.0.0",
    "zod": "^3.23.0",
    "tsx": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0",
    "@testcontainers/postgresql": "^10.13.0",
    "drizzle-kit": "^0.22.0",
    "postgres": "^3.4.0"
  }
}
