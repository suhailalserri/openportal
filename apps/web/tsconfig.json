{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target":        "ES2022",
    "lib":           ["dom", "dom.iterable", "ES2022"],
    "jsx":           "preserve",
    "moduleResolution": "bundler",
    "allowJs":       true,
    "outDir":        "./dist",
    "incremental":   true,
    "plugins":       [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
